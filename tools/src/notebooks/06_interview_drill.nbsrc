⏱ **~1 hour, then come back to it before every interview**

**How to use this:**
1. **Whiteboard round:** write the code below from memory, with no peeking at `minitf/`.
2. **Question round:** answer each question **out loud**, as if to an interviewer, *before* opening the answer. A good answer takes 30–60 seconds and includes *why*, not just *what*.
3. Mark the ones you got wrong and redo them tomorrow.

Many questions link back to an experiment you ran. In an interview, *"I tested this: when I removed positional encoding, accuracy dropped from 100% to ~15%"* is much stronger than a textbook answer.

#%% code
# Setup
import sys, pathlib
root = pathlib.Path.cwd()
while not (root / "minitf").is_dir() and root != root.parent:
    root = root.parent
sys.path.insert(0, str(root))
import math
import torch
import torch.nn.functional as F
from minitf import check

#%% md
## Whiteboard round

### ✍️ 1. Scaled dot-product attention with an optional mask, from memory (target: under 3 minutes)

#%% code
def attention_from_memory(q, k, v, mask=None):
    ### TODO: write it without looking
    scores = q @ k.transpose(-2, -1) / math.sqrt(q.size(-1))
    if mask is not None:
        scores = scores.masked_fill(~mask, float("-inf"))
    w = torch.softmax(scores, dim=-1)
    return w @ v, w
    ### END

check.check_sdpa(attention_from_memory)

#%% md
### ✍️ 2. The causal mask, the shift for teacher forcing, and the parameter count of a Transformer block

#%% code
def causal_mask_from_memory(T):
    ### TODO
    return torch.tril(torch.ones(T, T, dtype=torch.bool))
    ### END

def teacher_forcing_split(tgt):
    """tgt (B, T) = <bos> ... <eos>.  Return (decoder_input, targets)."""
    ### TODO
    return tgt[:, :-1], tgt[:, 1:]
    ### END

def decoder_block_params(d, d_ff):
    """Masked self-attention + cross-attention + FFN + 3 LayerNorms (all with biases)."""
    ### TODO
    return 2 * 4 * (d * d + d) + (2 * d * d_ff + d_ff + d) + 3 * 2 * d
    ### END

check.check_causal_mask(causal_mask_from_memory)
t = torch.tensor([[1, 5, 6, 7, 2]])
check.equal("teacher_forcing_split", [x.tolist() for x in teacher_forcing_split(t)], [[[1, 5, 6, 7]], [[5, 6, 7, 2]]])
from minitf._reference.transformer import DecoderBlock
check.equal("decoder block params (512, 2048)", decoder_block_params(512, 2048),
            sum(p.numel() for p in DecoderBlock(512, 8, 2048).parameters()))

