#%% code
# Setup: run this cell first.
%load_ext autoreload
%autoreload 2
import sys, pathlib
root = pathlib.Path.cwd()
while not (root / "minitf").is_dir() and root != root.parent:
    root = root.parent
sys.path.insert(0, str(root))

import copy, math, random, time
import torch
import torch.nn.functional as F
import matplotlib.pyplot as plt
from minitf import check, viz
from minitf.data import CharVocab, FORMATS, make_batch, sample_batch, make_test_set, random_pair
from minitf.transformer import Transformer

device = "mps" if torch.backends.mps.is_available() else "cpu"
vocab = CharVocab()
print("device:", device, "| vocabulary size:", len(vocab))

#%% md
## 1. The data

The task: translate a human-written date into ISO format. There are 10 input formats and dates from 1900 to 2099. Tokens are **characters**.

#%% code
rng = random.Random(0)
for fmt in FORMATS:
    src, tgt, _ = random_pair(rng, fmt)
    print(f"{fmt:>16}:  {src:<32} ->  {tgt}")

#%% code
src, tgt = make_batch([random_pair(rng) for _ in range(3)], vocab)
print("src:", tuple(src.shape), "(B, S)\n", src)
print("tgt:", tuple(tgt.shape), "(B, T)  starts with <bos>=1, ends with <eos>=2, padded with <pad>=0\n", tgt)
print("decoded back:", [vocab.decode(s) for s in src])

#%% md
## 2. Teacher forcing

During training, we give the decoder the **correct** previous characters and ask it to predict the **next** one at every position:

```
tgt     = <bos> 2 0 2 6 - 1 1 - 2 4 <eos>
tgt_in  = <bos> 2 0 2 6 - 1 1 - 2 4          ← decoder input  (drop the last token)
tgt_out =       2 0 2 6 - 1 1 - 2 4 <eos>    ← what it must predict at each position (drop the first)
```

All 11 predictions are trained in **one forward pass, in parallel**. That's only possible because the causal mask stops position *t* from seeing `tgt_in[t+1:]`. This parallelism is a big reason Transformers replaced RNNs, which must process one step at a time even during training.

### ✍️ Your turn: `train_step`
1. Split `tgt` into `tgt_in` and `tgt_out` (slicing on dim 1).
2. `logits = model(src, tgt_in)` has shape `(B, T, V)`.
3. Cross-entropy needs `(N, V)` logits and `(N,)` targets, so flatten with `.reshape(-1, V)` and `.reshape(-1)`. Pass **`ignore_index=vocab.pad_id`** so we don't train the model to predict padding.
4. `zero_grad`, `backward`, `step`. Return `loss.item()`.

#%% code
def train_step(model, optimizer, src, tgt):
    ### TODO
    tgt_in, tgt_out = tgt[:, :-1], tgt[:, 1:]
    logits = model(src, tgt_in)
    loss = F.cross_entropy(logits.reshape(-1, logits.size(-1)), tgt_out.reshape(-1), ignore_index=vocab.pad_id)
    optimizer.zero_grad()
    loss.backward()
    optimizer.step()
    return loss.item()
    ### END

#%% code
torch.manual_seed(0);
_m = Transformer(len(vocab))
_src, _tgt = make_batch([random_pair(random.Random(i)) for i in range(8)], vocab)
_tgt[0, -1] = vocab.pad_id   # make sure some padding is present
_logits = copy.deepcopy(_m)(_src, _tgt[:, :-1])
_expected = F.cross_entropy(_logits.reshape(-1, len(vocab)), _tgt[:, 1:].reshape(-1), ignore_index=0).item()
_got = train_step(_m, torch.optim.Adam(_m.parameters(), lr=1e-3), _src, _tgt)
check.close("loss returned by train_step", _got, _expected,
            hint="tgt_in = tgt[:, :-1], tgt_out = tgt[:, 1:], and ignore_index=vocab.pad_id.")
_l = [train_step(_m, torch.optim.Adam(_m.parameters(), lr=1e-3), _src, _tgt) for _ in range(30)]
check.equal("loss goes down when training on one batch", _l[-1] < _l[0] * 0.7, True)

#%% md
## 3. Train (~30–60 seconds)

The training loop is written for you. It draws a **fresh random batch** every step from ~730,000 possible (date, format) pairs, so the model can't memorise and has to learn the rules.

> The paper also uses a learning-rate **warm-up** schedule and **label smoothing** (0.1). Our model is tiny, so plain Adam is enough.

#%% code
def train(model, steps=1500, batch_size=128, lr=1e-3, seed=0, log_every=250, verbose=True):
    rng = random.Random(seed)
    optimizer = torch.optim.Adam(model.parameters(), lr=lr)
    model.train()
    losses, t0 = [], time.time()
    for step in range(1, steps + 1):
        src, tgt = sample_batch(batch_size, vocab, rng, device)
        losses.append(train_step(model, optimizer, src, tgt))
        if verbose and step % log_every == 0:
            print(f"step {step:>5}  loss {sum(losses[-50:]) / 50:.4f}  ({time.time() - t0:.0f}s)")
    return losses

torch.manual_seed(0);
model = Transformer(len(vocab), d_model=64, n_heads=4, n_layers=2, d_ff=256).to(device)
print(f"{sum(p.numel() for p in model.parameters()):,} parameters; initial loss should be ≈ ln({len(vocab)}) = {math.log(len(vocab)):.2f}")
losses = train(model)
viz.plot_curves({"train loss": losses}, title="training loss", logy=True)

#%% md
## 4. Inference: greedy decoding

At inference time there's no correct answer to feed in. We **generate one character at a time**:

```
step 1:  decoder input <bos>               → predict "2"
step 2:  decoder input <bos> 2             → predict "0"
step 3:  decoder input <bos> 2 0           → predict "2"   ... until <eos>
```
**Training:** one parallel pass. **Inference:** one pass per output token, in sequence. (The encoder still runs only **once**: its output `memory` is reused at every step.)

### ✍️ Your turn: `greedy_decode`
1. `memory, src_mask = model.encode(src)`, done once.
2. Start `ys` as a `(B, 1)` tensor filled with `vocab.bos_id` (`torch.full`, on `src.device`).
3. Repeat `max_len` times: `logits = model.decode(ys, memory, src_mask)`. Take the **last position's** logits (`logits[:, -1]`), pick the `argmax`, and append it to `ys` with `torch.cat(..., dim=1)`.
4. Return `ys[:, 1:]` (drop `<bos>`). `vocab.decode` stops at `<eos>` for you.

#%% code
@torch.no_grad()
def greedy_decode(model, src, max_len=11):
    model.eval()
    ### TODO
    memory, src_mask = model.encode(src)
    ys = torch.full((src.size(0), 1), vocab.bos_id, dtype=torch.long, device=src.device)
    for _ in range(max_len):
        logits = model.decode(ys, memory, src_mask)
        next_token = logits[:, -1].argmax(dim=-1, keepdim=True)
        ys = torch.cat([ys, next_token], dim=1)
    return ys[:, 1:]
    ### END

#%% code
def translate(text, model=None):
    model = model or globals()["model"]
    src = torch.tensor([vocab.encode(text.lower())], device=device)
    return vocab.decode(greedy_decode(model, src)[0])

test_set = make_test_set(n_per_format=100)

def evaluate(model):
    """Exact-match accuracy on the fixed test set: overall and per format."""
    src, _ = make_batch(test_set, vocab, device)
    preds = [vocab.decode(p) for p in greedy_decode(model, src)]
    per_fmt = {}
    for (s, t, fmt), p in zip(test_set, preds):
        per_fmt.setdefault(fmt, []).append(p == t)
    per_fmt = {f: sum(v) / len(v) for f, v in per_fmt.items()}
    return sum(per_fmt.values()) / len(per_fmt), per_fmt

for text in ["tuesday, november 24, 2026", "1/1/2000", "the 3rd of july, 1969", "2049/12/31"]:
    print(f"{text:<30} -> {translate(text)}")
acc, per_fmt = evaluate(model)
print(f"\ntest accuracy: {acc:.1%}")
check.equal("test accuracy above 95%", acc > 0.95, True,
            hint="If training loss went low but accuracy is bad, the bug is probably in greedy_decode.")

#%% md
🎉 **You built and trained a Transformer from scratch.** Try your own dates:

#%% code
print(translate("24 nov 2026"))
print(translate("sat 1 jan 2000"))

#%% md
> **Beyond greedy:** *beam search* keeps the k best partial outputs instead of 1 (the paper uses k=4 for translation). LLM chat uses *sampling* with a temperature, top-k or top-p. And the **KV cache**: at each step, the keys and values of past tokens don't change, so real implementations store them instead of recomputing the whole prefix. Our `greedy_decode` recomputes everything each step, which is $O(T^2)$ instead of $O(T)$ steps of work. That's fine for 11 characters.

## 5. Look inside: what does the model attend to?

We generate an output, then run the decoder once more over it to collect each layer's attention weights (your `MultiHeadAttention` saves them in `.last_attn`).

#%% code
@torch.no_grad()
def run_and_collect(text):
    src = torch.tensor([vocab.encode(text)], device=device)
    output = translate(text)
    tgt_in = torch.tensor([[vocab.bos_id] + vocab.encode(output)], device=device)
    model.eval()
    model(src, tgt_in)
    src_labels = vocab.tokens(src[0])
    out_labels = ["→" + c for c in output] + ["→<eos>"]     # row t = the decoder position predicting this char
    return output, src_labels, out_labels

def show_cross_attention(text, layer=-1, per_head=False):
    output, src_labels, out_labels = run_and_collect(text)
    w = model.decoder_layers[layer].cross_attn.last_attn[0].cpu()           # (h, T_out, T_in)
    title = f"cross-attention, decoder layer {layer}: '{text}' → '{output}'"
    if per_head:
        viz.plot_attention_heads(w, src_labels, out_labels, title=title)
    else:
        viz.plot_attention(w.mean(0), src_labels, out_labels, title=title + " (mean of heads)", annotate=False)

show_cross_attention("tuesday, november 24, 2026", layer=-1)

#%% code
show_cross_attention("24/11/2026", layer=-1, per_head=True)

#%% code
show_cross_attention("2026/11/24", layer=-1)
show_cross_attention("the 3rd of july, 1969", layer=-1)

